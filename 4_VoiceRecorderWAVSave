import sounddevice as sd
import scipy.io.wavfile as wav

sec = int (input ("Record Seconds: ")) #5  #Duration of recording in seconds
fs = 44100  #Sample rate

print("Recording...")
audio = sd.rec(int(sec * fs), samplerate=fs, channels=2)
sd.wait()  #Wait until recording is finished
#print("Recording complete.")    

wav.write("4_VoiceRecorderWAVSave.wav", fs, audio)  #Save as WAV file
print("Saved Recording <4_VoiceRecorderWAVSave.wav> complete.")
